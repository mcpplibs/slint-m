// ui/app.slint -> app.h and `export module app.ui;` (mcpplibs.mplugin.slint, which
// mcpplibs.mwrap.slint hands to this build program, on the SDK compat.slint provides).
import mcpp;
import mcpplibs.mplugin.slint;

int main() {
    mcpplibs::mplugin::slint::options o;
    o.sources = {"ui/app.slint"};
    o.module  = "app.ui";
    o.edition = "1.19";
    return mcpplibs::mplugin::slint::compile(o) ? 0 : 1;
}
