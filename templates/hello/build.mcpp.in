// ui/app.slint -> app.h and `export module app.ui;` (mcpp.mcpplibs.slintgen, which
// mcpplibs.mwrap.slint hands to this build program, on the SDK compat.slint provides).
import mcpp;
import mcpp.mcpplibs.slintgen;

int main() {
    mcpp::mcpplibs::slintgen::options o;
    o.sources = {"ui/app.slint"};
    o.module  = "app.ui";
    o.edition = "1.19";
    return mcpp::mcpplibs::slintgen::compile(o) ? 0 : 1;
}
