// ui/app.slint -> app.h and `export module app.ui;` (slint.mcpp.plugins, which
// package mcpplibs.slintgen runs on the SDK compat.slint provides).
import mcpp;
import slint.mcpp.plugins;

int main() {
    mcpp::plugins::slint::options o;
    o.module  = "app.ui";
    o.edition = "1.19";
    return mcpp::plugins::slint::compile(o) ? 0 : 1;
}
