[package]
name    = "{{project.name}}"
version = "0.1.0"

[targets.{{project.name}}]
kind = "bin"
main = "src/main.cpp"

[build]
# ui/app.slint reaches mcpp.plugins.slint, which writes app.h and the module app.ui.
sources = ["src/*.cpp", "ui/app.slint"]

[dependencies]
{{self.name}} = "{{self.version}}"

# The build rule: ui/app.slint -> app.h and the module app.ui. Its feature
# classifies `.slint` as a source the rule claims.
[build-dependencies]
mcpplibs.slintgen = { version = "{{self.version}}", features = ["slint"] }
