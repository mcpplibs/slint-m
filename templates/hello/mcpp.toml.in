[package]
name    = "{{project.name}}"
version = "0.1.0"

[targets.{{project.name}}]
kind = "bin"
main = "src/main.cpp"

# build.mcpp compiles ui/app.slint into app.h and the module app.ui
# (mcpp.mcpplibs.slintgen, which the wrapper hands to the build program).
[dependencies]
{{self.name}} = "{{self.version}}"
